{% extends '@Forumify/admin/base.html.twig' %}
{% set botService = 'MajesticDev\\Discord\\Service\\BotService::' %}
{% block body %}
    <h1>Discord Plugin Settings</h1>
    <p class="flex items-center gap-2">
        <span class="text-bold">Bot status:</span>
        {%- if status == constant(botService ~ 'STATUS_ONLINE') -%}
            <i class="ph ph-cloud-check" style="color: green"></i>
        {%- elseif status == constant(botService ~ 'STATUS_NOT_REGISTERED') -%}
            <i class="ph ph-question" style="color: orange"></i>
        {%- else -%}
            <i class="ph ph-cloud-x" style="color: red"></i>
        {%- endif -%}
        <span>{{ status|capitalize|replace({ '-': ' ' }) }}</span>
    </p>
    <div class="mt-6">
        {% if status == constant(botService ~ 'STATUS_NOT_REGISTERED') %}
            <div class="box rich-text">
                <p class="mb-4">This instance uses a self-hosted Discord bot, not forumify's own hosted bot - there's nothing to invite from here. Instead:</p>
                <ol>
                    <li>Invite your bot's own Discord application to your server from that application's page in the <a href="https://discord.com/developers/applications" target="_blank">Discord Developer Portal</a> (OAuth2 &rarr; URL Generator, scopes <code>bot</code> + <code>applications.commands</code>). You must be an administrator on the server you want to use this bot on.</li>
                    <li>Deploy/start the bot process pointed at this forumify instance (<code>{{ app.request.uri|replace({ (app.request.requestUri): '', 'http://': 'https://' }) }}</code>), giving it these OAuth client credentials so it can authenticate its API calls here:
                        <ul>
                            <li><strong>client_id:</strong> {{ client.clientId }}</li>
                            <li><strong>client_secret:</strong> {{ client.clientSecret }}</li>
                        </ul>
                    </li>
                    <li>On startup, the bot registers itself with forumify automatically - no Discord command needed.</li>
                </ol>
                <p>Once it's running, click refresh below.</p>
                <p class="text-center">
                    <a class="btn-outlined" href="{{ path('discord_admin_settings') }}"><i class="ph ph-arrows-clockwise"></i>Refresh</a>
                </p>
            </div>
        {% elseif form is not null %}
            <div class="box">
                <p class="alert-info rich-text mb-4">
                    Invite links, role mappings, and channel targets are now configured per Discord server -
                    see <a href="{{ path('forumify_admin_discord_connections_list') }}">Discord Connections</a>.
                </p>
                {{ form_start(form) }}
                {% if form.discord__calendars is defined %}
                    {{ form_row(form.discord__calendars) }}
                {% endif %}
                <div class="alert-warning rich-text mb-4">
                    <p>All settings below this modify server members. For this to work there are 2 prerequisites:</p>
                    <ol>
                        <li>The bot's role must be as high as possible in the roles list. And even then, it will most likely not be able to modify server administrators or the server owner.</li>
                        <li>The target user must have their Discord account linked to their forumify profile through the <a href="{{ path('forumify_admin_identity_providers_list') }}">Discord identity provider</a>.</li>
                    </ol>
                    <p>If you want to force all of your users to link a Discord account, you can enable this setting:</p>
                    {{ form_row(form.discord__force_connect_account) }}
                </div>
                {{ form_row(form.discord__force_user_in_server) }}
                {{ form_row(form.discord__force_matching_username) }}
                <div class="flex justify-center items-center gap-2">
                    <button type="submit" class="btn-primary">{{ 'save'|trans }}</button>
                    <a href="{{ path('forumify_admin_plugin_list') }}" class="btn-outlined">{{ 'cancel'|trans }}</a>
                </div>
                {{ form_end(form) }}
            </div>
        {% else %}
            <div class="flex justify-center">
                <p class="alert-error w-60 box text-center">
                    <i class="ph-fill ph-cloud-x"></i>
                    The bot is currently unreachable so settings can not be modified.
                    Please try again later or contact forumify support if the issue persists.
                </p>
            </div>
        {% endif %}
    </div>
{% endblock %}
