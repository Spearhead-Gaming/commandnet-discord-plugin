{
    "name": "majesticdev/commandnet-discord-plugin",
    "description": "Multi-guild Discord bridge for the Command Net plugin suite: syncs Discord roles, usernames, slash commands and notifications across one connection per unit's Discord server.",
    "type": "forumify-plugin",
    "keywords": ["symfony-ux"],
    "license": "proprietary",
    "require": {
        "forumify/forumify-platform": "^1.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "*"
    },
    "autoload": {
        "psr-4": {
            "MajesticDev\\Discord\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "forumify-plugin-class": "MajesticDev\\Discord\\CommandNetDiscordPlugin"
    }
}
