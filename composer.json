{
    "name": "majesticdev/commandnet-discord-plugin",
    "description": "Multi-guild fork of forumify-discord-plugin: syncs Discord roles, usernames, slash commands and notifications across one connection per unit's Discord server instead of a single global server.",
    "type": "forumify-plugin",
    "keywords": ["symfony-ux"],
    "license": "OSL-3.0",
    "require": {
        "forumify/forumify-platform": "^1.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "phpstan/phpstan-symfony": "^2.0",
        "slevomat/coding-standard": "*"
    },
    "autoload": {
        "psr-4": {
            "Forumify\\Discord\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "forumify-plugin-class": "Forumify\\Discord\\ForumifyDiscordPlugin",
        "branch-alias": {
            "dev-master": "1.1.x-dev"
        }
    }
}
